# ==========================================================
# AI Trend Radar Agent - Environment Configuration
# ==========================================================

# 1. Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Primary LLM Provider: 'ollama', 'groq', or 'openrouter'
# Use 'ollama' when running locally (100% offline, zero API keys, no rate limits)
LLM_PROVIDER=ollama

# Local Ollama Settings
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Groq Settings (Cloud fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter Settings (Cloud alternative)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 3. Email Delivery Configuration (Standard SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here
EMAIL_RECIPIENT=your_recipient@gmail.com

# 4. Agent Autonomy & Quality Thresholds
MIN_TREND_VELOCITY_SCORE=3.0
CRITIC_APPROVAL_THRESHOLD=8.5
ENABLE_SIGNIFICANCE_GATE=true

# 5. Schedule Settings (Once daily run hour in 24h format: 7 for 07:00 AM)
DAILY_RUN_HOUR=7
DAILY_RUN_MINUTE=0
SAMPLING_INTERVAL_HOURS=4

# 6. Supabase RSS Catalog Sync Settings (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
